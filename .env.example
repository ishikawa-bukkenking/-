# Railway の「Variables」に設定する値(値は各自のものに)
DATABASE_URL=            # Railway の PostgreSQL を追加すると自動で入る(Reference変数 ${{Postgres.DATABASE_URL}})
GOOGLE_CLIENT_ID=        # Google Cloud の OAuthクライアントID(ウェブアプリ)
SESSION_SECRET=          # ランダムな長い文字列(ログインの署名用)
BASE_URL=                # 例: https://xxxx.up.railway.app (独自ドメインを付けたらそのURL)
GOOGLE_MAPS_API_KEY=     # 任意。Geocoding API のキー(無いときは国土地理院の住所検索のみ)
ANTHROPIC_API_KEY=       # 任意。入力画面でも設定可(表のAI読み取り用)
